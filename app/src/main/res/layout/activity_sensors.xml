<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tvTituloSensors"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monitoreo de Sensores"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp" />

    <!-- Estado de conexión Bluetooth -->
    <TextView
        android:id="@+id/tvEstadoConexion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Estado: Desconectado"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Valores del sensor (ID corregido: tvValorSensor) -->
    <TextView
        android:id="@+id/tvValorSensor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Temp: -- °C | Hum: -- %"
        android:textSize="18sp"
        android:layout_marginBottom="24dp" />

    <!-- Botón de Conectar -->
    <Button
        android:id="@+id/btnConectar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="Conectar con HC-05"
        android:layout_marginBottom="24dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnVolverMain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="← Volver" />

        <Button
            android:id="@+id/btnSiguienteControl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Control →" />
    </LinearLayout>

</LinearLayout>