<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Título del Proyecto -->
    <TextView
        android:id="@+id/tvTituloDescripcion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Descripción del Proyecto"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="24dp" />

    <!-- Lista de Sensores -->
    <TextView
        android:id="@+id/tvListaSensores"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sensores Utilizados:\n• DHT11 (Temperatura y Humedad)\n• FC-28 (Humedad de Suelo)"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <!-- Lista de Actuadores -->
    <TextView
        android:id="@+id/tvListaActuadores"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Actuadores Utilizados:\n• Bomba de Agua / Relé\n• Módulo Bluetooth HC-05"
        android:textSize="16sp"
        android:layout_marginBottom="32dp" />

    <!-- Espaciador flexible para empujar los botones hacia abajo -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Botones de navegación inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnBackToLogin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:layout_marginEnd="8dp"
            android:text="← Volver (Login)" />

        <Button
            android:id="@+id/btnNextToSensors"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:layout_marginStart="8dp"
            android:text="Siguiente (Sensores) →" />
    </LinearLayout>

</LinearLayout>