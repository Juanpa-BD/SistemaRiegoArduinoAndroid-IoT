<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center">

    <!-- Título / Bienvenida -->
    <TextView
        android:id="@+id/tvTituloSplash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sistema de Riego IoT"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvSubtituloSplash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monitoreo y Control con Arduino / Bluetooth"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="40dp" />

    <!-- Botón con el ID que busca SplashActivity.kt -->
    <Button
        android:id="@+id/btnNextToLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="Ir al Login" />

</LinearLayout>